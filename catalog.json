  "pages": {
    "list": {
      "intro": [
        "s:intro",
        "$count",
        "?desktop:s:intro_keys",
        "?mobile:s:intro_touch"
      ],
      "item": [
        "?new:s:new",
        "g:title",
        "?elsewhere:$onlyOn",
        "?comingSoon:$price",
        "g:short"
      ],
      "itemDetail": [
        "g:short"
      ],
      "itemAction": "open:game",
      "previewTrailerAfterSec": 1.5,
      "footer": [
        {
          "say": [
            "s:back_to_game"
          ],
          "action": "close"
        }
      ]
    },
    "game": {
      "enter": [],
      "items": [
        {
          "say": [
            "g:title",
            "?elsewhere:$onlyOn",
            "g:short"
          ],
          "action": "speak"
        },
        {
          "say": [
            "?!comingSoon:s:buy_{platform}",
            "?comingSoon:s:wishlist_{platform}",
            "$price",
            "$discount"
          ],
          "action": "store",
          "if": "store"
        },
        {
          "say": [
            "?desktop:s:trailer",
            "?mobile:s:trailer_touch"
          ],
          "action": "trailer",
          "if": "trailer"
        },
        {
          "say": [
            "$platforms"
          ],
          "action": "speak",
          "if": "platforms"
        },
        {
          "say": [
            "?!comingSoon:s:buy_{platform}",
            "?comingSoon:s:wishlist_{platform}",
            "$price",
            "$discount"
          ],
          "action": "store",
          "if": "store"
        },
        {
          "say": [
            "s:back"
          ],
          "action": "back"
        }
      ]
    }
  },
