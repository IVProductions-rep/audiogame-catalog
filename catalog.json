        { "say": ["$platforms"], "action": "speak", "if": "platforms" },
        { "say": ["?!comingSoon:s:buy_{platform}", "?comingSoon:s:wishlist_{platform}", "$price", "$discount"], "action": "store", "if": "store" },
        { "say": ["s:back"], "action": "back" }
      ]
    }
